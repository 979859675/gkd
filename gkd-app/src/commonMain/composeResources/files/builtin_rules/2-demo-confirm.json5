{
  // 仓库内置规则文件夹 (composeResources/files/builtin_rules) 中的规则文件。
  // 首次启动且该 id 不存在时自动导入为本地订阅，之后可由用户自由编辑或删除。
  id: 20002,
  name: '内置规则 · 示例确认弹窗',
  version: 1,
  author: 'GKD 内置规则文件夹',
  categories: [],
  apps: [
    {
      id: 'com.gkd.demo.confirm',
      name: '示例确认弹窗应用',
      groups: [
        {
          name: '自动确认',
          key: 1,
          desc: '示例规则，展示弹窗类规则的写法。把 app id 换成目标应用即可生效',
          rules: [
            {
              key: 1,
              name: '点击确认',
              matches: ['[text="确认"]', '[text="同意"]'],
              excludeMatches: ['[text="取消"]'],
            },
          ],
        },
      ],
    },
  ],
}
